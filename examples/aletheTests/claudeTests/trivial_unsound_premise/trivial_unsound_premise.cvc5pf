(assume a0 (not (or g (= u s))))
(assume a1 g)
(step t0 (cl (or g (= s u)) (not g)) :rule or_neg)
(step t1 (cl (or g (= s u))) :rule resolution :premises (t0 a1))
(step t2 (cl (not (= (not (or g (= u s))) (not (or g (= s u))))) (not (not (or g (= u s)))) (not (or g (= s u)))) :rule equiv_pos2)
(step t3 (cl (= g g)) :rule refl)
(step t4 (cl (= (= u s) (= s u))) :rule all_simplify)
(step t5 (cl (= (or g (= u s)) (or g (= s u)))) :rule cong :premises (t3 t4))
(step t6 (cl (= (not (or g (= u s))) (not (or g (= s u))))) :rule cong :premises (t5))
(step t7 (cl (not (or g (= s u)))) :rule resolution :premises (t2 t6 a0))
(step t8 (cl) :rule resolution :premises (t1 t7))
